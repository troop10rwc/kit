{
  "name": "@troop10rwc/ui",
  "version": "0.3.0",
  "type": "module",
  "description": "Troop 10 back-office component library + design tokens (the five interaction models).",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "theme.css",
    "fonts.css",
    "STYLE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.1.0",
    "@fontsource-variable/hanken-grotesk": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@radix-ui/react-dialog": "^1.1.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
