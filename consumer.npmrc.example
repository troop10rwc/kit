# Copy this to `.npmrc` in each consuming app repo (scoutpack, etc.).
# It tells npm/pnpm to resolve the @troop10rwc scope from GitHub Packages.
# pnpm reads this same .npmrc format, so no extra config is needed.

@troop10rwc:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}

# The @troop10rwc/* packages are PUBLIC, so any valid GitHub token can install
# them — no `read:packages` scope and no per-repo access grant needed. But note:
# GitHub Packages' npm registry has no anonymous access, so a token is still
# required even for public packages.
#
#   - CI:         use the built-in token directly — it works from any repo:
#                   NPM_TOKEN: ${{ secrets.GITHUB_TOKEN }}
#   - Local dev:  any GitHub Personal Access Token (classic) works. Put it in your
#                 *user* ~/.npmrc, NOT in the committed file, or export NPM_TOKEN.
