{
  "name": "@troop10rwc/kit",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Shared UI, Worker, and type packages for Troop 10 RWC apps (scoutpack and friends).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/troop10rwc/kit.git"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "clean": "rm -rf packages/*/dist",
    "release:patch": "node scripts/bump.mjs patch && git push --follow-tags",
    "release:minor": "node scripts/bump.mjs minor && git push --follow-tags"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
